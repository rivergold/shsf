# SHSF automatically reads project-root .env; process environment takes precedence.
# export SHSF_DATABASE_URL='postgresql://shsf:CHANGE_ME@localhost:5432/shsf'
# SHSF_DATABASE_URL=sqlite:///.data/pipeline.sqlite3
SHSF_DATA_DIR=.data/pipeline
SHSF_PROFILE=config/robotics.json
# Replace with a real contact address before a long-running harvest.
SHSF_USER_AGENT=shsf/0.1 (personal robotics literature research)
# SPECTER2 base + proximity adapter and immutable revisions are in
# shsf/embeddings.py; changing configuration creates a new model key.

# Agent channel: api or chatgpt. Saved page selection takes precedence.
SHSF_AGENT_MODE=api
SHSF_LLM_PROVIDER=openai_compatible
# Base URL only, without /chat/completions or /responses suffix.
SHSF_LLM_BASE_URL=https://api.openai.com/v1
SHSF_LLM_API_KEY=
# chat_completions or responses
SHSF_LLM_PROTOCOL=chat_completions
SHSF_LLM_MODEL=
# Blank task-specific values fall back to SHSF_LLM_MODEL.
SHSF_AGENT_EXPLAIN_MODEL=
SHSF_AGENT_READ_MODEL=
SHSF_LLM_TIMEOUT=60
# ChatGPT OAuth credentials are managed by the backend, not stored in .env.
